{
  "name": "wildwood-native-flow",
  "target": "desktop",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 2,
  "steps": [
    { "label": "world-visible", "waitTicks": 60, "screenshot": "world-visible" },
    { "label": "walk", "press": "KeyW", "holdTicks": 480, "release": true, "screenshot": "walk" },
    { "label": "settled", "waitTicks": 60, "screenshot": "settled" }
  ],
  "assert": {
    "movement": { "entity": "walker", "minDistance": 10 },
    "resources": [
      { "id": "state", "path": "odometer", "gte": 15, "changed": true },
      { "id": "state", "path": "valleyReady", "atSteps": [{ "label": "world-visible", "equals": true }] },
      { "id": "state", "path": "uiReady", "atSteps": [{ "label": "world-visible", "equals": true }] }
    ]
  }
}
