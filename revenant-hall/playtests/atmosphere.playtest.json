{
  "name": "atmosphere",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 30,
  "steps": [{ "kind": "wait", "label": "sun moves", "waitTicks": 600, "release": true }],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      { "id": "state", "path": "sunElevation", "changed": true },
      { "id": "state", "path": "sunAzimuth", "changed": true },
      { "id": "state", "path": "sunTransmittanceRed", "changed": true }
    ],
    "visual": [
      {
        "frameDiff": { "minChangedPixelRatio": 0.001 },
        "region": {
          "x": 0,
          "y": 0,
          "width": 1280,
          "height": 720,
          "minNonblankPixelRatio": 0.01
        }
      }
    ]
  }
}
