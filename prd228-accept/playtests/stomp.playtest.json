{
  "name": "platformer-stomp",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "near-patrol",
      "press": "ArrowRight",
      "holdTicks": 28,
      "release": true
    },
    {
      "kind": "input",
      "label": "jump",
      "press": ["ArrowRight", "Space"],
      "holdTicks": 42,
      "release": true
    },
    { "kind": "wait", "label": "stomp-settled", "waitTicks": 45, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "resources": [
      { "id": "state", "path": "defeated", "gte": 1, "changed": true },
      { "id": "state", "path": "jumps", "gte": 1, "changed": true },
      {
        "id": "state",
        "path": "hearts",
        "equals": 3,
        "allowTrivial": "A successful stomp should not damage the player; three hearts remains the intentional held invariant while defeat and jump prove the action."
      }
    ],
    "tags": [{ "tag": "patrol", "count": 0 }]
  }
}
