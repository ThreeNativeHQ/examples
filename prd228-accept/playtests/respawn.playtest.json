{
  "name": "platformer-respawn",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    { "kind": "input", "press": "ArrowRight", "holdTicks": 16, "release": true },
    {
      "kind": "input",
      "press": ["ArrowRight", "Space"],
      "holdTicks": 30,
      "release": true
    },
    { "kind": "wait", "waitTicks": 16, "release": true },
    { "kind": "input", "press": "ArrowRight", "holdTicks": 170, "release": true },
    { "kind": "wait", "waitTicks": 100, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "movement": {
      "entity": "player",
      "reachesPositionWithin": { "position": [14, 0.75, 0], "maxDistance": 2 }
    },
    "resources": [
      { "id": "state", "path": "checkpoint", "equals": 1, "changed": true },
      { "id": "state", "path": "respawns", "gte": 1, "changed": true }
    ]
  }
}
