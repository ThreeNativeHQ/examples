{
  "name": "platformer-coyote",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    { "kind": "input", "press": "ArrowRight", "holdTicks": 92, "release": true },
    { "kind": "wait", "waitTicks": 8, "release": true },
    { "kind": "input", "press": "Space", "holdTicks": 2, "release": true },
    { "kind": "wait", "waitTicks": 20, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "resources": [
      { "id": "state", "path": "jumps", "gte": 1, "changed": true },
      { "id": "state", "path": "coyoteJumps", "gte": 1, "changed": true }
    ]
  }
}
