{
  "name": "platformer-avoidance",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 0,
  "subject": "chaser.avoidance",
  "steps": [{ "kind": "wait", "waitTicks": 360, "release": true }],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "movement": {
      "entity": "chaser.avoidance",
      "reachesPositionWithin": { "position": [0, 0.66, 0], "maxDistance": 1.2 },
      "pathLength": 6.0
    },
    "components": [
      { "entity": "chaser", "component": "steeringFinished", "equals": true },
      { "entity": "chaser.avoidance", "component": "steeringFinished", "equals": true },
      { "entity": "chaser.avoidance", "component": "routeComplete", "equals": true },
      {
        "entity": "chaser.avoidance",
        "component": "separation",
        "gte": 0.56,
        "allowTrivial": "The avoidance fixture starts outside the minimum separation; this row records that authored held spacing while steering completion proves the run."
      }
    ]
  }
}
