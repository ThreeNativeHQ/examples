{
  "name": "platformer-terminal-loop-fail",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    { "kind": "input", "press": "ArrowRight", "holdTicks": 45, "release": true },
    { "kind": "wait", "waitTicks": 80, "release": true },
    { "kind": "input", "press": "ArrowLeft", "holdTicks": 50, "release": true },
    { "kind": "wait", "waitTicks": 80, "release": true },
    { "kind": "input", "press": "ArrowRight", "holdTicks": 80, "release": true },
    { "kind": "wait", "waitTicks": 80, "release": true },
    { "kind": "input", "press": "ArrowLeft", "holdTicks": 80, "release": true },
    { "kind": "wait", "waitTicks": 80, "release": true },
    { "kind": "input", "press": "ArrowRight", "holdTicks": 80, "release": true },
    { "kind": "wait", "waitTicks": 80, "release": true },
    { "kind": "input", "press": "ArrowLeft", "holdTicks": 30, "release": true },
    { "kind": "wait", "waitTicks": 60, "release": true },
    { "kind": "input", "press": "ArrowRight", "holdTicks": 40, "release": true },
    { "kind": "wait", "label": "fail-settled", "waitTicks": 120, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "resources": [
      { "id": "state", "path": "terminal", "equals": 2, "changed": true },
      { "id": "state", "path": "hearts", "equals": 0, "changed": true },
      {
        "id": "state",
        "path": "respawns",
        "equals": 0,
        "allowTrivial": "The terminal fail scenario ends before a respawn; zero respawns is the intentional held invariant for this failure path."
      }
    ],
    "signals": [{ "entity": "game", "name": "lost", "minCount": 1 }]
  }
}
