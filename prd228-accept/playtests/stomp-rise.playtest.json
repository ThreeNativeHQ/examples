{
  "name": "platformer-stomp-rise",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    { "kind": "input", "press": "ArrowRight", "holdTicks": 16, "release": true },
    {
      "kind": "input",
      "press": ["ArrowRight", "Space"],
      "holdTicks": 30,
      "release": true
    },
    { "kind": "wait", "waitTicks": 16, "release": true },
    {
      "kind": "input",
      "label": "enemy-contact",
      "press": "ArrowRight",
      "holdTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "rise-after-contact",
      "press": "Space",
      "holdTicks": 4,
      "release": true
    },
    { "kind": "wait", "label": "damage-settled", "waitTicks": 10, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "resources": [
      { "id": "state", "path": "hearts", "equals": 2, "changed": true },
      {
        "id": "state",
        "path": "defeated",
        "equals": 0,
        "allowTrivial": "The rising stomp must not defeat the enemy; zero defeated is the intentional held invariant before the landing action completes."
      }
    ],
    "tags": [
      {
        "tag": "patrol",
        "count": 1,
        "allowTrivial": "The rising stomp intentionally leaves the patrol tag present until the landing action completes; the damage and held defeated assertions prove this intermediate state."
      }
    ]
  }
}
