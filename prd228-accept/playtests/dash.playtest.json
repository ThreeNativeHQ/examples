{
  "name": "platformer-dash",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    { "kind": "input", "press": "ArrowRight", "holdTicks": 18, "release": false },
    { "kind": "input", "press": "ShiftLeft", "holdTicks": 6, "release": true },
    { "kind": "wait", "waitTicks": 20, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "movement": { "entity": "player", "minAxisDelta": { "axis": "+x", "min": 2.5 } },
    "resources": [
      { "id": "state", "path": "dashes", "gte": 1, "changed": true },
      { "id": "state", "path": "topSpeed", "gte": 12, "changed": true }
    ]
  }
}
