{
  "name": "platformer-damage",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    { "kind": "input", "press": "ArrowRight", "holdTicks": 16, "release": true },
    {
      "kind": "input",
      "press": ["ArrowRight", "Space"],
      "holdTicks": 30,
      "release": true
    },
    { "kind": "wait", "waitTicks": 16, "release": true },
    {
      "kind": "input",
      "label": "enemy-contact",
      "press": "ArrowRight",
      "holdTicks": 20,
      "release": true
    },
    { "kind": "wait", "label": "damage-settled", "waitTicks": 10, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "resources": [{ "id": "state", "path": "topSpeed", "gte": 1, "changed": true }],
    "components": [{ "entity": "player", "component": "health", "equals": 2, "changed": true }]
  }
}
