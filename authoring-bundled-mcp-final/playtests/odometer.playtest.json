{
  "name": "starter-deferred-motion-odometer",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "menu-is-up",
      "waitTicks": 120,
      "release": true
    },
    {
      "kind": "click",
      "at": {
        "x": 640,
        "y": 365
      },
      "label": "focus-name-field"
    },
    {
      "kind": "input",
      "label": "type-a",
      "press": "a",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "type-x",
      "press": "x",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "type-o",
      "press": "o",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "click",
      "at": {
        "x": 640,
        "y": 428
      },
      "label": "start-game"
    },
    {
      "kind": "wait",
      "label": "play-scene-loads",
      "waitTicks": 240,
      "release": true
    },
    {
      "kind": "input",
      "label": "move",
      "press": "ArrowUp",
      "holdTicks": 60,
      "release": true
    },
    {
      "kind": "wait",
      "label": "solver-applied",
      "waitTicks": 2,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "odometer",
        "gte": 1,
        "changed": true
      }
    ],
    "visibility": [
      {
        "allowTrivial": "The starter scene begins with the player visible and in frame; this held visibility row accompanies the odometer assertion.",
        "entity": "player",
        "minProjectedPixels": 20
      }
    ]
  }
}
