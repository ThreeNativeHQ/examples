{
  "name": "starter-menu-flow",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "steps": [
    {
      "kind": "wait",
      "label": "menu-is-up",
      "waitTicks": 120,
      "release": true
    },
    {
      "kind": "click",
      "at": {
        "x": 640,
        "y": 365
      },
      "label": "focus-name-field"
    },
    {
      "kind": "input",
      "label": "type-a",
      "press": "a",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "type-x",
      "press": "x",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "type-o",
      "press": "o",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "click",
      "at": {
        "x": 640,
        "y": 428
      },
      "label": "start-game"
    },
    {
      "kind": "wait",
      "label": "play-scene-loads",
      "waitTicks": 240,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": false,
      "networkErrorsOptOutReason": "This menu proof runs on every target, and only the browser has a CDP network observer; the screen transition and the carried name are asserted through resources, which all four targets observe.",
      "runtimeReady": true
    },
    "resources": [
      {
        "changed": true,
        "equals": "playing",
        "id": "state",
        "path": "screen"
      },
      {
        "equals": "axo",
        "id": "state",
        "path": "characterName"
      }
    ]
  }
}
