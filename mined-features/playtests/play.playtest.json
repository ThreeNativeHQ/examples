{
  "name": "play",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "warmupFrames": 60,
  "steps": [
    {
      "kind": "input",
      "press": "ArrowRight",
      "holdTicks": 60,
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 600,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "changed": true,
        "component": "glyphs",
        "entity": "hud"
      }
    ],
    "performance": {
      "maxDrawCalls": 32,
      "maxFrameMsP95": 33,
      "maxTriangles": 6200
    }
  }
}
