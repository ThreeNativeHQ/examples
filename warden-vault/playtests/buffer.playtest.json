{
  "name": "starter-jump-buffer",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "play-scene-loads",
      "waitTicks": 240,
      "release": true
    },
    {
      "kind": "input",
      "label": "first-jump",
      "press": "Space",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "near-landing",
      "waitTicks": 55,
      "release": true
    },
    {
      "kind": "input",
      "label": "buffered-jump",
      "press": "Space",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "buffered-arc",
      "waitTicks": 20,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "jumps",
        "equals": 2,
        "changed": true
      },
      {
        "id": "state",
        "path": "coyoteJumps",
        "equals": 0,
        "allowTrivial": "This buffer scenario exercises a jump without consuming coyote time; coyoteJumps staying at zero is the intentional held invariant."
      },
      {
        "id": "state",
        "path": "peakRise",
        "gte": 0.5,
        "changed": true
      }
    ],
    "visibility": [
      {
        "allowTrivial": "The starter scene begins with the player visible and in frame; this held visibility row accompanies the buffer assertion.",
        "entity": "player",
        "minProjectedPixels": 20
      }
    ]
  }
}
