{
  "acceptanceId": "AC5",
  "name": "boot-failure",
  "target": "web",
  "schemaVersion": 1,
  "bootFailure": "renderer-no-adapter",
  "awaitStartup": false,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 1,
  "steps": [
    {
      "kind": "wait",
      "label": "failure-surface",
      "waitFrames": 1
    }
  ],
  "assert": {
    "diagnostics": {
      "consoleErrorsOptOutReason": "The scenario intentionally blocks the renderer adapter, whose expected WebGL context error is the failure message being surfaced.",
      "noConsoleErrors": false
    },
    "hud": [
      {
        "allowTrivial": "The forced boot failure is present before the first step by design; this run checks that its message remains visible.",
        "id": "threenative-canvas-error",
        "textIncludes": "Error creating WebGL context",
        "visible": true
      }
    ],
    "visual": [
      {
        "region": {
          "element": {
            "id": "threenative-canvas-error"
          },
          "maxDarkPixelRatio": 0.5,
          "minNonblankPixelRatio": 0.002
        }
      }
    ]
  }
}
