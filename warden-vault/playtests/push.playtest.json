{
  "name": "warden-shoves-a-crate",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "fall-and-settle",
      "waitTicks": 400,
      "release": true
    },
    {
      "kind": "input",
      "label": "shove",
      "press": "ArrowRight",
      "holdTicks": 110,
      "release": true
    },
    {
      "kind": "wait",
      "label": "crate-comes-to-rest",
      "waitTicks": 90,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "pushedCrates",
        "gte": 1,
        "changed": true
      },
      {
        "id": "state",
        "path": "pushDistance",
        "gte": 0.5,
        "changed": true
      },
      {
        "id": "state",
        "path": "settled",
        "equals": true
      }
    ],
    "movement": {
      "entity": "player",
      "minDistance": 1.5,
      "minAxisDelta": {
        "axis": "x",
        "min": 1.5
      }
    },
    "visibility": [
      {
        "entity": "player",
        "minProjectedPixels": 100,
        "allowTrivial": "The vault is one fixed shot and the warden is framed in it from the first tick; this row is a held invariant and exists to catch a warden that leaves the picture."
      }
    ]
  }
}