{
  "name": "survives",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    { "kind": "wait", "label": "play-scene-loads", "waitTicks": 240, "release": true },
    { "kind": "input", "label": "move", "press": "ArrowRight", "holdTicks": 60, "release": true },
    { "kind": "wait", "label": "settle", "waitTicks": 10, "release": true }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "movement": { "entity": "player", "minDistance": 0.5 },
    "scene": { "litMaterialsAreLit": true, "minVisibleLights": 1 },
    "visual": [
      {
        "region": { "x": 0, "y": 0, "width": 1280, "height": 720, "minNonblankPixelRatio": 0.01 }
      }
    ]
  }
}
