{
  "name": "sail-and-collect", "target": "web", "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 }, "warmupFrames": 60, "subject": "player",
  "steps": [
    { "kind": "input", "label": "sail-to-island", "press": "ArrowUp", "holdTicks": 390, "release": true },
    { "kind": "wait", "label": "collect", "waitTicks": 30, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "movement": { "entity": "player", "minDistance": 20 },
    "components": [ { "entity": "treasure", "component": "collected", "equals": true }, { "entity": "player", "component": "wakeActive", "gte": 1 } ],
    "resources": [ { "id": "state", "path": "treasure", "equals": 1 }, { "id": "state", "path": "objectiveDistance", "equals": 0 } ],
    "visual": [ { "region": { "x": 0, "y": 0, "width": 1280, "height": 720, "minNonblankPixelRatio": 0.3 } } ]
  }
}
