{
  "schemaVersion": 1,
  "name": "quarry-android-walk-past-six-textured-props",
  "target": "web",
  "warmupFrames": 0,
  "steps": [
    { "kind": "wait", "waitTicks": 60, "label": "settle-on-stone", "release": true, "screenshot": "initial-world" },
    { "kind": "input", "press": "KeyW", "holdTicks": 450, "label": "walk-the-quarry-route", "release": true },
    { "kind": "wait", "waitTicks": 30, "label": "end-of-route", "release": true }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": false,
      "networkErrorsOptOutReason": "Android mailbox transport has no browser network observer.",
      "runtimeReady": true
    },
    "movement": { "entity": "walker", "minDistance": 20 },
    "resources": [
      { "id": "state", "path": "props", "equals": 6, "allowTrivial": "All six imported props must exist before and after the walk." },
      { "id": "state", "path": "texturedProps", "equals": 6, "allowTrivial": "Every imported prop retains a non-color material map after the packed mask is removed from base color." },
      { "id": "state", "path": "normalMappedProps", "equals": 6, "allowTrivial": "Every imported normal-map binding survives loading." },
      { "id": "state", "path": "stoneMaterialProps", "equals": 6, "allowTrivial": "Every imported stone uses a neutral base color instead of the packed mask texture." },
      { "id": "state", "path": "visited", "equals": 6, "changed": true },
      { "id": "state", "path": "distance", "gte": 20, "changed": true },
      { "id": "state", "path": "groundGap", "gte": -0.1, "lte": 0.2, "allowTrivial": "The controller stays on the stone floor throughout the route." }
    ]
  }
}
