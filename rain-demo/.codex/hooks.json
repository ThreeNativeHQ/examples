{
  "description": "Project-scoped ponytail activation; review and trust it with /hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/ponytail-context.mjs",
            "timeout": 5,
            "statusMessage": "Loading ponytail..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/ponytail-context.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/ponytail-context.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
