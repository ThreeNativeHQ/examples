{
  "name": "debug-endurance",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 20,
  "subject": "player",
  "steps": [
    { "kind": "input", "label": "advance", "press": "KeyW", "holdTicks": 120, "release": true },
    { "kind": "input", "label": "fall-back", "press": "KeyS", "holdTicks": 120, "release": true },
    { "kind": "input", "label": "shoot-1", "press": "Space", "holdTicks": 3, "release": true },
    { "kind": "wait", "label": "ride-the-clock", "waitTicks": 1700, "release": true },
    { "kind": "input", "label": "reload", "press": "KeyR", "holdTicks": 3, "release": true },
    { "kind": "wait", "label": "ride-out", "waitTicks": 1700, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "resources": [{ "id": "state", "path": "phase", "changed": true }]
  }
}
