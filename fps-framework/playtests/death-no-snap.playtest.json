{
  "name": "death-no-snap",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "subject": "enemy",
  "setup": {
    "entities": [
      {
        "entity": "player",
        "position": [
          -4.5,
          0.89,
          -5.0
        ]
      },
      {
        "entity": "enemy",
        "position": [
          -4.5,
          0,
          -6.8
        ]
      }
    ]
  },
  "steps": [
    {
      "kind": "wait",
      "label": "body-measured",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "head-shot",
      "press": "Space",
      "holdTicks": 3,
      "release": true
    },
    {
      "kind": "wait",
      "label": "death-settle",
      "waitTicks": 300,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "enemy",
        "component": "deathObserved",
        "equals": true,
        "allowTrivial": true
      },
      {
        "entity": "enemy",
        "component": "deathAnkleDelta",
        "lte": 0.02,
        "allowTrivial": true
      },
      {
        "entity": "enemy",
        "component": "deathClipFrames",
        "gte": 30,
        "allowTrivial": true
      },
      {
        "entity": "enemy",
        "component": "deathClip",
        "equals": "DeathHeadshot",
        "allowTrivial": true
      },
      {
        "entity": "enemy",
        "component": "deathFallDot",
        "gte": 0.0,
        "allowTrivial": true
      },
      {
        "entity": "enemy",
        "component": "lastHitMultiplier",
        "equals": 4,
        "allowTrivial": true
      }
    ]
  }
}
