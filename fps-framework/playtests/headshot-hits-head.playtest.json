{
  "name": "headshot-hits-head",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 30,
  "subject": "enemy",
  "setup": {
    "entities": [
      { "entity": "player", "position": [-4.5, 0.89, -5.0] },
      { "entity": "enemy", "position": [-4.5, 0, -6.8] }
    ]
  },
  "steps": [
    { "kind": "wait", "label": "body-measured", "waitTicks": 5, "release": true },
    { "kind": "input", "label": "head-shot", "press": "Space", "holdTicks": 3, "release": true },
    { "kind": "wait", "label": "hit-registered", "waitTicks": 8, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "components": [
      { "entity": "enemy", "component": "headZoneMinY", "gte": 1.3, "allowTrivial": true },
      { "entity": "enemy", "component": "hitboxHeight", "gte": 1.73, "lte": 1.83, "allowTrivial": true },
      { "entity": "enemy", "component": "lastHitMultiplier", "equals": 4, "allowTrivial": true }
    ]
  }
}
