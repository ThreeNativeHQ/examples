{
  "name": "walkway-reachable",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 20,
  "subject": "player",
  "steps": [
    { "kind": "input", "label": "reach-ramp", "press": "KeyD", "holdTicks": 120, "release": true },
    { "kind": "input", "label": "walk-ramp", "press": "KeyW", "holdTicks": 240, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "components": [
      { "entity": "player", "component": "positionY", "gte": 3.6 }
    ]
  }
}
