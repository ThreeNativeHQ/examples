{
  "name": "starter-area-monitoring",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "collect",
      "press": "ArrowRight",
      "holdTicks": 100,
      "release": true
    },
    { "kind": "input", "label": "leave", "press": "ArrowLeft", "holdTicks": 25, "release": true },
    {
      "kind": "input",
      "label": "reenter-while-disabled",
      "press": "ArrowRight",
      "holdTicks": 25,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "resources": [
      {
        "id": "GameState",
        "path": "score",
        "equals": 1,
        "changed": true,
        "atSteps": [
          { "label": "collect", "equals": 1 },
          { "label": "reenter-while-disabled", "equals": 1 }
        ]
      }
    ],
    "visibility": [{ "entity": "player", "minProjectedPixels": 20 }]
  }
}
