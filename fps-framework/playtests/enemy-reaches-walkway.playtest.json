{
  "name": "enemy-reaches-walkway",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 20,
  "subject": "enemy",
  "steps": [
    { "kind": "input", "label": "reach-x", "press": "KeyD", "holdTicks": 120, "release": true },
    { "kind": "input", "label": "reach-z", "press": "KeyW", "holdTicks": 270, "release": true },
    { "kind": "input", "label": "draw-under-walkway", "press": "Space", "holdTicks": 3, "release": true },
    { "kind": "wait", "label": "path", "waitTicks": 600, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "components": [
      { "entity": "enemy", "component": "underWalkway", "equals": true }
    ]
  }
}
