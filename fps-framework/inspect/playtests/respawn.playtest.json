{
  "name": "starter-respawn",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "run-off-world",
      "press": "ArrowRight",
      "holdTicks": 240,
      "release": true
    },
    { "kind": "wait", "label": "respawn", "waitTicks": 90, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "movement": {
      "entity": "player",
      "pathLength": 4,
      "reachesPositionWithin": { "position": [-2, 0.5, 0], "maxDistance": 0.35 }
    },
    "resources": [{ "id": "GameState", "path": "respawns", "gte": 1, "changed": true }],
    "visibility": [{ "entity": "player", "minProjectedPixels": 20 }]
  }
}
