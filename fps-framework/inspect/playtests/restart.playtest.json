{
  "name": "starter-react-restart",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "collected",
      "press": "ArrowRight",
      "holdTicks": 100,
      "release": true
    },
    { "kind": "input", "label": "focus-pause", "press": "Tab", "holdTicks": 1, "release": true },
    { "kind": "input", "label": "focus-restart", "press": "Tab", "holdTicks": 1, "release": true },
    { "kind": "input", "label": "restarted", "press": "Enter", "holdTicks": 1, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "resources": [
      {
        "id": "GameState",
        "path": "score",
        "atSteps": [{ "label": "collected", "equals": 1 }, { "label": "restarted", "equals": 0 }]
      },
      {
        "id": "GameState",
        "path": "entityCount",
        "atSteps": [{ "label": "collected", "equals": 2 }, { "label": "restarted", "equals": 3 }]
      }
    ],
    "visibility": [{ "entity": "player", "minProjectedPixels": 20 }]
  }
}
