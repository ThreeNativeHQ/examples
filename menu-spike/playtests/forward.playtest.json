{
  "name": "starter-forward",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    { "kind": "input", "label": "forward", "press": "ArrowUp", "holdTicks": 60, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "movement": { "entity": "player", "minAxisDelta": { "axis": "-z", "min": 0.5 } }
  }
}
