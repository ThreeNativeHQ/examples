{
  "name": "menu-flow",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "steps": [
    {
      "kind": "wait",
      "label": "menu-is-up",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "focus-name-field",
      "press": "Tab",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "type-a",
      "press": "a",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "type-x",
      "press": "x",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "type-o",
      "press": "o",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "focus-begin-button",
      "press": "Tab",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "submit-form",
      "press": "Enter",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "play-scene-loads",
      "waitTicks": 90,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    }
  }
}