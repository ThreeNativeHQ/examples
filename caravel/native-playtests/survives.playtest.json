{
  "name": "native-sailing-smoke",
  "target": "desktop",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "sail-forward",
      "press": "ArrowUp",
      "holdTicks": 60,
      "release": true
    },
    {
      "kind": "wait",
      "label": "observe-movement",
      "waitTicks": 10,
      "release": true
    }
  ],
  "assert": {
    "movement": {
      "entity": "player",
      "minDistance": 0.5
    },
    "renderChain": {
      "tier": "high",
      "stages": {
        "includes": ["bloom"]
      }
    }
  }
}
