{
  "name": "survives",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "sail-forward",
      "press": "ArrowUp",
      "holdTicks": 60,
      "release": true
    },
    { "kind": "wait", "label": "settle", "waitTicks": 10, "release": true }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "components": [
      {
        "allowTrivial": "The ship has an authored non-unit size; this retained factor proves normaliseToMetres ran in the generated vessel.",
        "component": "normaliseFactor",
        "entity": "player",
        "lte": 0.99
      }
    ],
    "movement": { "entity": "player", "minDistance": 0.5 },
    "visual": [
      {
        "region": {
          "x": 0,
          "y": 0,
          "width": 1280,
          "height": 720,
          "minNonblankPixelRatio": 0.01
        }
      }
    ]
  }
}
