{
  "name": "capsize-is-a-loss",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    { "kind": "input", "label": "capsize", "press": "KeyC", "holdTicks": 1, "release": true },
    { "kind": "wait", "label": "observe-loss", "waitTicks": 10, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "resources": [
      {
        "id": "state",
        "path": "status",
        "equals": "lost",
        "changed": true,
        "atSteps": [{ "label": "observe-loss", "equals": "lost" }]
      }
    ]
  }
}
