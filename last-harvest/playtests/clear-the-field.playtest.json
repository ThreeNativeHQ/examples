  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "GameState",
        "path": "candidateCount",
        "equals": 1048576,
        "allowTrivial": "The candidate count is a held invariant: the field is built with exactly 1,048,576 candidates and must still report that number at the end, so it is deliberately true at step zero too."
      },
      {
        "id": "GameState",
        "path": "cpuCandidateWrites",
        "equals": 0,
        "throughoutSteps": true,
        "allowTrivial": "Zero CPU candidate writes is a held invariant, not a transition. A million blades touched per frame on the CPU would still render correctly, just slowly, so nothing but this number says otherwise \u2014 and it must be zero at step zero as well."
      },
      {
        "id": "GameState",
        "path": "indirectBound",
        "equals": 1,
        "throughoutSteps": true,
        "allowTrivial": "The geometry carrying its compute-written indirect buffer is a held invariant; if the projection or anything else swapped it, the draw count would come from the CPU and the field would still appear to draw."
      },
      {
        "id": "GameState",
        "path": "resetDispatches",
        "gte": 400,
        "changed": true
      },
      {
        "id": "GameState",
        "path": "cullDispatches",
        "gte": 400,
        "changed": true
      },
      {
        "id": "GameState",
        "path": "cutTotal",
        "gte": 10000,
        "changed": true
      },
      {
        "id": "GameState",
        "path": "standingNow",
        "gte": 50000,
        "changed": true,
        "allowTrivial": "The drawn survivor count is a held invariant with a floor, not a transition: a fixed-radius cull circle contains a near-constant number of blades however far the harvester drives, which is what makes it the right number to draw with and the wrong number to play with. A field that stopped culling, or a count the CPU supplied, would not hold it."
      },
      {
        "id": "GameState",
        "path": "driven",
        "gte": 50,
        "changed": true
      },
      {
        "id": "GameState",
        "path": "outcome",
        "equals": "cleared",
        "changed": true
      }
    ]
  }
}
