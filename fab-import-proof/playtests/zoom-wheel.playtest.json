{
  "acceptanceId": "camera-intent",
  "name": "starter-zoom-wheel",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "subject": "player",
  "artifacts": {
    "screenshots": "before-after"
  },
  "steps": [
    {
      "kind": "wait",
      "label": "play-scene-loads",
      "waitTicks": 240,
      "release": true
    },
    {
      "kind": "input",
      "label": "zoom-wheel",
      "wheel": {
        "deltaY": -500
      },
      "waitTicks": 30,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "camera": {
      "entity": "camera.main",
      "follows": "player",
      "targetInViewport": true,
      "within": 9.2
    },
    "visibility": [
      {
        "allowTrivial": "The starter scene begins with the player visible and in frame; this held visibility row accompanies the zoom distance assertion.",
        "entity": "player",
        "minProjectedPixels": 20
      }
    ],
    "visual": [
      {
        "frameDiff": {
          "minChangedPixelRatio": 0.01
        }
      }
    ]
  }
}
