{
  "name": "starter-look",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "artifacts": {
    "screenshots": "before-after"
  },
  "steps": [
    {
      "kind": "wait",
      "label": "play-scene-loads",
      "waitTicks": 600,
      "release": true
    },
    {
      "kind": "input",
      "label": "move-camera",
      "press": "ArrowRight",
      "holdTicks": 220,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "camera": {
      "entity": "camera.main",
      "follows": "player",
      "targetInViewport": true,
      "within": 9.5
    },
    "movement": {
      "entity": "player",
      "minDistance": 4
    },
    "visibility": [
      {
        "allowTrivial": "The starter scene begins with the player visible and in frame; this held visibility row accompanies the look assertion.",
        "entity": "player",
        "minProjectedPixels": 20
      }
    ],
    "visual": [
      {
        "frameDiff": {
          "minChangedPixelRatio": 0.01
        }
      },
      {
        "region": {
          "x": 0,
          "y": 0,
          "width": 1280,
          "height": 720,
          "minNonblankPixelRatio": 0.95,
          "minDarkPixelRatio": 0.2,
          "maxLuminance": 0.25
        }
      }
    ]
  }
}
