{
  "name": "midway-flight",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 30,
  "steps": [
    { "kind": "click", "label": "take-the-deck", "at": { "x": 183, "y": 542 }, "release": true },
    { "kind": "wait", "label": "deck-settle", "waitTicks": 30, "release": true },
    { "kind": "input", "label": "launch", "press": ["KeyW", "ArrowUp"], "holdTicks": 1100, "release": true, "screenshot": "takeoff.png" },
    { "kind": "input", "label": "climb-out", "press": "KeyW", "holdTicks": 700, "release": true },
    { "kind": "input", "label": "wide-view", "press": "KeyC", "holdTicks": 3, "release": true },
    { "kind": "input", "label": "wide-view-2", "press": "KeyC", "holdTicks": 3, "release": true },
    { "kind": "wait", "label": "settle", "waitTicks": 90, "release": true, "screenshot": "flight.png" }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true }
  }
}
