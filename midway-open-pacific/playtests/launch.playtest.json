{
  "name": "midway-launches",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 30,
  "steps": [
    { "kind": "click", "label": "take-the-deck", "at": { "x": 183, "y": 542 }, "release": true },
    { "kind": "wait", "label": "deck-settle", "waitTicks": 30, "release": true },
    { "kind": "input", "label": "throttle-up", "press": "KeyW", "holdTicks": 240, "release": true },
    { "kind": "input", "label": "rotate", "press": "ArrowUp", "holdTicks": 180, "release": true },
    { "kind": "wait", "label": "settle", "waitTicks": 90, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true }
  }
}
