  "scripts": {
    "dev": "vite",
    "build": "threenative build",
    "build:web": "threenative build --target web",
    "build:desktop": "threenative build --target desktop",
    "build:android": "threenative build --target android",
    "build:ios": "threenative build --target ios",
    "test:native": "pnpm build:desktop && threenative-playtest --scenario native-playtests/survives.playtest.json --scenario native-playtests/float.playtest.json --target desktop --executable dist-native/midway-open-pacific",
    "pretest": "playwright install chromium",
    "test": "vite build && threenative-playtest --scenario \"playtests/*.playtest.json\" --browser-recipe webgpu --headed --server-command \"pnpm dev --host 127.0.0.1 --port $PORT --strictPort\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:audio": "node scripts/check-audio.mjs",
    "verify:hud": "node scripts/check-hud-transport.mjs",
    "verify": "pnpm typecheck && pnpm verify:audio && pnpm verify:hud"
  },
