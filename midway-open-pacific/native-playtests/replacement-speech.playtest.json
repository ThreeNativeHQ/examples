{
  "name": "midway-native-replacement-speech",
  "schemaVersion": 1,
  "target": "desktop",
  "steps": [
    {
      "label": "briefing",
      "waitTicks": 420
    },
    {
      "pointerPosition": {
        "x": 0.149,
        "y": 0.831,
        "buttons": 1
      },
      "release": true,
      "waitTicks": 30
    },
    {
      "label": "take-deck",
      "waitForResource": {
        "id": "state",
        "path": "ui.screens.flight",
        "equals": true
      },
      "timeoutMs": 60000
    },
    {
      "kind": "input",
      "label": "throttle",
      "press": "KeyW",
      "holdTicks": 900,
      "release": true
    },
    {
      "kind": "input",
      "label": "rotate",
      "press": "ArrowDown",
      "holdTicks": 60,
      "release": true
    },
    {
      "kind": "wait",
      "label": "climb",
      "waitTicks": 420,
      "release": true
    },
    {
      "kind": "input",
      "label": "dive",
      "press": "ArrowUp",
      "holdTicks": 400,
      "release": true
    },
    {
      "label": "downed",
      "waitForResource": {
        "id": "state",
        "path": "mode",
        "equals": "downed"
      },
      "timeoutMs": 60000
    },
    {
      "kind": "wait",
      "label": "downed-panel",
      "waitTicks": 180,
      "release": true
    },
    {
      "pointerPosition": {
        "x": 0.5,
        "y": 0.6,
        "buttons": 1
      },
      "release": true,
      "waitTicks": 60
    },
    {
      "label": "replacement",
      "waitForResource": {
        "id": "state",
        "path": "mode",
        "equals": "deck"
      },
      "timeoutMs": 60000
    },
    {
      "kind": "wait",
      "label": "second-deck",
      "waitTicks": 600,
      "release": true
    }
  ],
  "assert": {
    "audio": [
      {
        "cue": "speech:p01",
        "minPlays": 1,
        "maxPlays": 1
      }
    ],
    "resources": [
      {
        "id": "state",
        "path": "mode",
        "atSteps": [
          {
            "label": "replacement",
            "equals": "deck"
          }
        ]
      }
    ]
  }
}
