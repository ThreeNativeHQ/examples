{
  "name": "midway-native-launch",
  "schemaVersion": 1,
  "target": "desktop",
  "steps": [
    { "kind": "input", "label": "throttle", "press": "KeyW", "holdTicks": 900, "release": true },
    { "kind": "input", "label": "rotate", "press": "ArrowDown", "holdTicks": 60, "release": true },
    { "kind": "wait", "label": "climb", "waitTicks": 600, "release": true, "screenshot": "native-flight.png" }
  ],
  "assert": {
    "resources": [
      { "id": "state", "path": "status", "atSteps": [{ "label": "throttle", "equals": "playing" }] },
      { "id": "state", "path": "airborne", "atSteps": [{ "label": "climb", "equals": true }] },
      { "id": "state", "path": "altitude", "changed": true },
      { "id": "state", "path": "ias", "changed": true }
    ]
  }
}
