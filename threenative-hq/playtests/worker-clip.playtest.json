{
  "name": "hq-worker-clips",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "subject": "worker-0",
  "steps": [
    {
      "kind": "wait",
      "label": "boot",
      "waitTicks": 60,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settle-walk",
      "waitTicks": 60,
      "release": true
    },
    {
      "kind": "input",
      "label": "to-working",
      "press": "KeyN",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settle-work",
      "waitTicks": 90,
      "release": true
    },
    {
      "kind": "input",
      "label": "to-thinking",
      "press": "KeyN",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settle-think",
      "waitTicks": 90,
      "release": true
    },
    {
      "kind": "input",
      "label": "to-idle",
      "press": "KeyN",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settle-idle",
      "waitTicks": 90,
      "release": true
    },
    {
      "kind": "input",
      "label": "to-blocked",
      "press": "KeyN",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settle-blocked",
      "waitTicks": 120,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "focusClip",
        "changed": true,
        "atSteps": [
          {
            "label": "settle-walk",
            "equals": "Walk_Formal_Loop"
          },
          {
            "label": "settle-work",
            "equals": "Driving_Loop"
          },
          {
            "label": "settle-think",
            "equals": "Sitting_Talking_Loop"
          },
          {
            "label": "settle-idle",
            "equals": "Sitting_Idle_Loop"
          },
          {
            "label": "settle-blocked",
            "equals": "Idle_TalkingPhone_Loop"
          }
        ]
      },
      {
        "id": "state",
        "path": "officeReady",
        "equals": true,
        "allowTrivial": "The office builds its room and its first worker before the first frame is sampled; these two rows are a boot invariant, and the clip rows above carry the transitions."
      },
      {
        "id": "state",
        "path": "workerCount",
        "equals": 1,
        "allowTrivial": "The office builds its room and its first worker before the first frame is sampled; these two rows are a boot invariant, and the clip rows above carry the transitions."
      }
    ],
    "animation": [
      {
        "entity": "worker-0",
        "clip": "Idle_TalkingPhone_Loop",
        "entered": true,
        "advancedFrames": 5
      }
    ],
    "visibility": [
      {
        "entity": "worker-0",
        "minProjectedPixels": 40,
        "allowTrivial": "The worker is framed from the first tick on purpose \u2014 this office has no camera to move. The clip rows above prove the mixer ran; this row only proves the figure is still drawn at the end."
      }
    ]
  }
}