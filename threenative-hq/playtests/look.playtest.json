{
  "name": "hq-look",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 30,
  "subject": "worker-0",
  "steps": [
    { "kind": "wait", "label": "arrive", "waitTicks": 120, "release": true },
    { "kind": "wait", "label": "settle", "waitTicks": 120, "release": true }
  ],
  "assert": {
    "diagnostics": { "noNetworkErrors": true, "runtimeReady": true },
    "resources": [{ "id": "state", "path": "officeReady", "equals": true }]
  }
}
