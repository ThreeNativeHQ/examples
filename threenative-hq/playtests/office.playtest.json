{
  "name": "hq-office",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 0,
  "steps": [
    {
      "kind": "wait",
      "label": "first-frame",
      "waitTicks": 30,
      "release": true
    },
    {
      "kind": "input",
      "label": "walk-onto-the-floor",
      "press": "KeyW",
      "holdTicks": 150,
      "release": true
    },
    {
      "kind": "wait",
      "label": "walk-in",
      "waitTicks": 420,
      "release": true
    },
    {
      "kind": "wait",
      "label": "script-plays",
      "waitTicks": 300,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 180,
      "release": true
    },
    {
      "kind": "click",
      "label": "pick-a-session-in-the-panel",
      "at": {
        "x": 1100,
        "y": 262
      }
    },
    {
      "kind": "wait",
      "label": "card-opens",
      "waitTicks": 60,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "arrivals",
        "gte": 4,
        "changed": true
      },
      {
        "id": "state",
        "path": "departures",
        "gte": 1,
        "changed": true
      },
      {
        "id": "state",
        "path": "blockedSeen",
        "equals": true,
        "changed": true
      },
      {
        "id": "state",
        "path": "focusProject",
        "equals": "rpg-api",
        "changed": true
      },
      {
        "id": "state",
        "path": "selectedProject",
        "equals": "rpg-api",
        "changed": true
      }
    ],
    "movement": {
      "entity": "worker-claude-104",
      "minDistance": 2
    }
  }
}