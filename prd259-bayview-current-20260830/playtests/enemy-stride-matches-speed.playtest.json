      {
        "entity": "enemy",
        "component": "locomotionRatePeak",
        "gte": 1.5,
        "allowTrivial": "the peak is sticky and the soldiers patrol from spawn, so warmup may already have banked a walking rate before the baseline snapshot; the value check still fails at 1.0, which is what an un-re-timed walk clip reads"
      },
      {
        "entity": "enemy",
        "component": "maxEnvelopeRadius",
        "lte": 0.8,
        "allowTrivial": "the envelope is calibrated once in the constructor, so it is constant for the run by design; it reads 1.589 when the vertex walk measures a collapsed skin and 0.453 when it measures the real one"
      },
      {
        "entity": "enemy",
        "component": "clipGroundSpeed",
        "gte": 1,
        "allowTrivial": "the measured stride rests at zero until a locomotion clip is chosen, so the resting value is honest"
      },
