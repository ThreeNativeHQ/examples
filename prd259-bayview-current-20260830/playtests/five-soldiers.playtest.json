{
  "name": "five-soldiers",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "subject": "enemy",
  "steps": [
    {
      "kind": "wait",
      "label": "settled",
      "waitTicks": 200,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "blips.0.alive",
        "equals": true,
        "allowTrivial": "every soldier reports alive at a quiet start, so the opening value is the honest one"
      },
      {
        "id": "state",
        "path": "blips.4.alive",
        "equals": true,
        "allowTrivial": "every soldier reports alive at a quiet start, so the opening value is the honest one"
      },
      {
        "id": "state",
        "path": "blips.4.x",
        "changed": true,
        "lte": -0.5
      }
    ],
    "components": [
      {
        "entity": "enemy",
        "component": "modelHeight",
        "gte": 1.73,
        "lte": 1.83,
        "allowTrivial": "held invariant of the loaded rig geometry, not driven by scenario input"
      },
      {
        "entity": "enemy-1",
        "component": "modelHeight",
        "gte": 1.73,
        "lte": 1.83,
        "allowTrivial": "held invariant of the loaded rig geometry, not driven by scenario input"
      },
      {
        "entity": "enemy-2",
        "component": "modelHeight",
        "gte": 1.73,
        "lte": 1.83,
        "allowTrivial": "held invariant of the loaded rig geometry, not driven by scenario input"
      },
      {
        "entity": "enemy-3",
        "component": "modelHeight",
        "gte": 1.73,
        "lte": 1.83,
        "allowTrivial": "held invariant of the loaded rig geometry, not driven by scenario input"
      },
      {
        "entity": "enemy-4",
        "component": "modelHeight",
        "gte": 1.73,
        "lte": 1.83,
        "allowTrivial": "held invariant of the loaded rig geometry, not driven by scenario input"
      }
    ]
  }
}
