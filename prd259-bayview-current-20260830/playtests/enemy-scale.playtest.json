{
  "name": "enemy-scale",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "subject": "enemy",
  "steps": [
    {
      "kind": "wait",
      "label": "patrol",
      "waitTicks": 200,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "enemy",
        "component": "modelHeight",
        "gte": 1.73,
        "lte": 1.83,
        "allowTrivial": "held invariant of the loaded rig geometry, not driven by scenario input"
      },
      {
        "entity": "enemy",
        "component": "rifleLength",
        "gte": 0.77,
        "lte": 0.99,
        "allowTrivial": "held invariant of the loaded rig geometry, not driven by scenario input"
      },
      {
        "entity": "rifle",
        "component": "viewmodelLength",
        "gte": 0.75,
        "lte": 1.01,
        "allowTrivial": "held invariant of the loaded rig geometry, not driven by scenario input"
      }
    ],
    "resources": [
      {
        "id": "state",
        "path": "blips.0.x",
        "changed": true
      }
    ]
  }
}
