# Generated by @threenative/assets from the sources in assets/. Hand-owned static files
# (favicon, launcher icons) stay in public/ and are committed; these outputs never are.
public/assets.manifest.json
public/*.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].*

# Captured frames are local debugging evidence, not shipped source. The folder itself stays.
screenshots/*
!screenshots/.gitkeep
