{
  "name": "face-controls",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 0,
  "steps": [
    {
      "label": "the-specimen-is-bound-and-ready",
      "release": true,
      "timeoutMs": 120000,
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "ready"
      }
    },
    {
      "kind": "wait",
      "label": "neutral-settled",
      "waitTicks": 60,
      "release": true,
      "screenshot": "neutral"
    },
    {
      "kind": "click",
      "label": "focus-the-jaw-open-slider-at-1113-174",
      "at": {
        "x": 1113,
        "y": 174
      },
      "waitTicks": 2,
      "release": true
    },
    {
      "kind": "click",
      "label": "jaw-open-to-half-with-a-real-click",
      "at": {
        "x": 1113,
        "y": 174
      },
      "waitTicks": 2,
      "release": true
    },
    {
      "kind": "input",
      "label": "jaw-keyboard-steps",
      "press": "ArrowRight",
      "holdTicks": 8,
      "release": true
    },
    {
      "kind": "wait",
      "label": "jaw-settled",
      "waitTicks": 30,
      "release": true,
      "screenshot": "jaw-open"
    },
    {
      "kind": "click",
      "label": "focus-the-eyes-blink-left-slider-at-1070-622",
      "at": {
        "x": 1070,
        "y": 622
      },
      "waitTicks": 2,
      "release": true
    },
    {
      "kind": "click",
      "label": "blink-left-to-half-with-a-real-click",
      "at": {
        "x": 1113,
        "y": 622
      },
      "waitTicks": 2,
      "release": true
    },
    {
      "kind": "input",
      "label": "blink-keyboard-steps",
      "press": "ArrowRight",
      "holdTicks": 8,
      "release": true
    },
    {
      "kind": "wait",
      "label": "blink-settled",
      "waitTicks": 30,
      "release": true,
      "screenshot": "left-blink"
    },
    {
      "kind": "click",
      "label": "smile-recipe",
      "at": {
        "x": 1057,
        "y": 45
      },
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "click",
      "label": "brow-recipe",
      "at": {
        "x": 1136,
        "y": 45
      },
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "wait",
      "label": "combined-settled",
      "waitTicks": 40,
      "release": true,
      "screenshot": "smile-brow"
    }
  ],
  "artifacts": {
    "screenshots": "after"
  },
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "phase",
        "equals": "ready",
        "allowTrivial": "Readiness is the precondition this run waits for, so the value is already 'ready' at the first sample; the wait is the assertion that it arrives."
      },
      {
        "id": "state",
        "path": "frames",
        "gte": 10
      },
      {
        "id": "state",
        "path": "controls.jawOpen",
        "gte": 0.4
      },
      {
        "id": "state",
        "path": "controls.blinkL",
        "gte": 0.4
      },
      {
        "id": "state",
        "path": "controls.blinkR",
        "equals": 0,
        "allowTrivial": "The right eyelid must not move when only the left blink slider was driven. The value is 0 at the first sample because the run starts from the declared neutral, so the check that survives is that it never left 0."
      },
      {
        "id": "state",
        "path": "controls.smileL",
        "gte": 0.7
      },
      {
        "id": "state",
        "path": "controls.browRaiseInnerL",
        "gte": 0.6
      },
      {
        "id": "state",
        "path": "probeJawJoint",
        "gte": 0.05,
        "allowTrivial": "Sampled from the rig's joint output as applied to the FACIAL_C_Jaw node's local transform against its exported rest transform. 0 at the first sample because the run starts at the declared neutral."
      },
      {
        "id": "state",
        "path": "probeJawMorph",
        "gte": 0.4,
        "changed": true
      },
      {
        "id": "state",
        "path": "probeBlinkMorphLeft",
        "gte": 0.4,
        "changed": true
      },
      {
        "id": "state",
        "path": "probeBlinkMorphRight",
        "equals": 0,
        "allowTrivial": "The unilateral proof: the right eyelid's applied morph influence. 0 at the first sample because the run starts at the declared neutral; the assertion is that the left blink left it there."
      },
      {
        "id": "state",
        "path": "probeSmileMorphLeft",
        "gte": 0.7,
        "changed": true
      }
    ]
  }
}
