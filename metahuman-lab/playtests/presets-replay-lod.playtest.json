    "resources": [
      {
        "id": "state",
        "path": "phase",
        "equals": "ready",
        "allowTrivial": "Readiness is the precondition this run waits for, so the value is already 'ready' at the first sample; the wait is the assertion that it arrives."
      },
      {
        "id": "state",
        "path": "frames",
        "gte": 10
      },
      {
        "id": "state",
        "path": "controls.jawOpen",
        "atSteps": [
          {
            "label": "combined-settled",
            "equals": 0.7
          },
          {
            "label": "neutral-restored",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "intensity",
        "atSteps": [
          {
            "label": "intensity-settled",
            "equals": 0.55
          }
        ],
        "allowTrivial": "The recipe's intensity, at the step right after a real click and a real key press drove it. 1 at the first sample because that is where it starts, and the run ends on 1 because reset restores it \u2014 so the value that survives is the one taken while the recipe was live."
      },
      {
        "id": "state",
        "path": "probeJawJoint",
        "atSteps": [
          {
            "label": "neutral-restored",
            "equals": 0
          },
          {
            "label": "lod1-settled",
            "equals": 0.131542
          }
        ]
      },
      {
        "id": "state",
        "path": "probeSmileMorphLeft",
        "atSteps": [
          {
            "label": "neutral-restored",
            "equals": 0
          },
          {
            "label": "lod0-expression",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "demoSample",
        "atSteps": [
          {
            "label": "scrub-settled-a",
            "equals": {
              "t": 1.5,
              "jawJoint": 0.019292,
              "jawMorph": 0.1,
              "smileMorphLeft": 0.9,
              "blinkMorphLeft": 0
            }
          },
          {
            "label": "scrub-settled-b",
            "equals": {
              "t": 1.5,
              "jawJoint": 0.019292,
              "jawMorph": 0.1,
              "smileMorphLeft": 0.9,
              "blinkMorphLeft": 0
            }
          }
        ],
        "allowTrivial": "A4's whole claim, and the two expected values are the same one on purpose: the same demo time reached through playback and then through an anger preset must sample the same rig output. The probe is read off the Three.js objects after the update, so it is the face and not the transport. Each sample is gated by a wait-for-state on a field of the sample itself, because the probes are published once per drawn frame and a tick-only settle can leave the previous pose standing."
      },
      {
        "id": "state",
        "path": "lod",
        "atSteps": [
          {
            "label": "lod1-settled",
            "equals": 1
          },
          {
            "label": "lod0-restored",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "lodVertices",
        "atSteps": [
          {
            "label": "lod0-expression",
            "equals": 38911
          },
          {
            "label": "lod1-settled",
            "equals": 19269
          },
          {
            "label": "lod0-restored",
            "equals": 38911
          }
        ],
        "allowTrivial": "Counted off the visible skinned meshes rather than read from a constant, so the three numbers say which level is on screen: LOD0's welded head and brow cards, LOD1's 19 269, and LOD0 again."
      },
      {
        "id": "state",
        "path": "probeJawJoint",
        "atSteps": [
          {
            "label": "lod0-expression",
            "equals": 0.131542
          },
          {
            "label": "lod1-settled",
            "equals": 0.131542
          }
        ],
        "allowTrivial": "A5's expression half: the jaw joint the rig applied is the same number on both levels, which is what 'the expression survives the switch' means for a level that has no blend shapes to apply it to."
      },
      {
        "id": "state",
        "path": "probeSmileMorphLeft",
        "atSteps": [
          {
            "label": "lod0-expression",
            "equals": 1
          },
          {
            "label": "lod1-settled",
            "equals": 0
          }
        ],
        "allowTrivial": "The other half of A5: the smile is a blend shape, LOD1 carries no morph targets, and the applied influence goes to 0 rather than being left stale at 1 on a mesh that is no longer drawn. Both samples are gated by a wait-for-state on this field, so neither can be the LOD0 frame published before the switch."
      },
      {
        "id": "state",
        "path": "controls.smileL",
        "atSteps": [
          {
            "label": "lod0-expression",
            "equals": 1
          },
          {
            "label": "lod1-settled",
            "equals": 1
          }
        ],
        "allowTrivial": "The controls themselves are untouched by the LOD switch \u2014 the rig is given the same vector on both levels, and it is the mesh set and the evaluator that change."
      },
      {
        "id": "state",
        "path": "blinkAuto",
        "atSteps": [
          {
            "label": "automation-running",
            "equals": true
          },
          {
            "label": "precedence-after-manual-edit",
            "equals": false
          }
        ],
        "allowTrivial": "The PRD's precedence, on the one half of it a click can decide: a manual edit to a channel an automation owns switches that automation off."
      },
      {
        "id": "state",
        "path": "gazeAuto",
        "atSteps": [
          {
            "label": "automation-running",
            "equals": true
          },
          {
            "label": "precedence-after-manual-edit",
            "equals": true
          }
        ],
        "allowTrivial": "Automation only ever gives up the channels it owns, so the blink edit one step earlier must leave gaze automation exactly as it was. It is false at the first sample, so the assertion that survives is that it turned on and stayed on."
      },
      {
        "id": "state",
        "path": "playing",
        "atSteps": [
          {
            "label": "automation-running",
            "equals": true
          },
          {
            "label": "precedence-after-manual-edit",
            "equals": false
          }
        ],
        "allowTrivial": "A manual edit stops playback: the demo supplied a base vector one step before this, and a slider is the PRD's definition of taking the face back."
      },
      {
        "id": "state",
        "path": "controls.gazeHorizontalL",
        "changed": true,
        "allowTrivial": "The enabled automation is driving its own channels, so the gaze channels have to be moving on their own with no slider touched."
      },
      {
        "id": "state",
        "path": "poseStatus",
        "textIncludes": "loaded"
      },
      {
        "id": "state",
        "path": "controls.blinkL",
        "atSteps": [
          {
            "label": "pose-restored",
            "equals": 0.5
          }
        ],
        "allowTrivial": "The saved pose's blink channel, after the round trip: the automations were switched off before the save so the file carries the manual 0.5 and nothing else, and loading it back has to put that exact 0.5 on the face."
      },
      {
        "id": "state",
        "path": "controls.smileL",
        "gte": 0.9
      },
      {
        "id": "state",
        "path": "preset",
        "equals": "neutral",
        "allowTrivial": "Neutral at the first sample because the lab boots neutral, which is exactly the value the run has to end on: reset is what puts it back, and a scenario that ended on a recipe would say so."
      }
    ]
  }
}
