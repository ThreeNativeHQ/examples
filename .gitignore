node_modules/
dist/
.packages/
.pnpm-store/
*.tgz
.DS_Store

# Sealed benchmark reference images. They are third-party screenshots used as a visual target,
# so they stay on disk and out of a public repository. The brief describes them in words.
reference.png

# Third-party game assets handed to a build as source material. Two of the FPS models are not
# cleared for redistribution — the first-person viewmodel records "user-provided; verify
# upstream pack terms before redistribution", and the enemy is CC-BY-4.0 carrying retargeted
# Mixamo clips. They stay on disk, where a build can load them, and out of a public repository.
# Same call this file already makes for reference.png.
/fps-kit/
/fps-framework/assets/
/fps-framework/screenshots/
/fps-vanilla/assets/

# The sandbox root is scratch for whichever build ran last: pnpm sandbox rewrites these three
# every run, and ./scaffold.sh copies them into the game folder. Committing the root copies
# leaves the previous game's brief sitting at the top of the repository, describing nothing.
# Each game folder keeps its own; these paths are anchored to the root only.
/brief.md
/sweep.json
/scaffold.sh

# Build output and device staging. Every one of these is regenerated by a build or a device run
# and none of it is source: native bundles, packaged APKs, patched/aligned/signed APK staging, and
# the screenshots a device probe drops. A 250 MB APK in a repository is a mistake that is hard to
# undo, so these are anchored broadly rather than per game.
dist-web/
dist-native/
.threenative/
artifacts/
*.apk
*.aab
*.keystore
