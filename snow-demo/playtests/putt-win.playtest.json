      "kind": "wait",
      "label": "boot",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "wait",
      "label": "address",
      "waitTicks": 240,
      "release": true
    },
    {
      "kind": "input",
      "label": "push1",
      "press": "KeyG",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "roll1",
      "waitTicks": 300,
      "release": true
    },
    {
      "kind": "input",
      "label": "push2",
