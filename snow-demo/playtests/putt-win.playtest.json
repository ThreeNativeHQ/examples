    },
    {
      "kind": "input",
      "label": "push4",
      "press": "KeyG",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "roll4",
      "waitTicks": 300,
      "release": true
    },
    {
      "kind": "input",
      "label": "push5",
      "press": "KeyG",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "roll5",
      "waitTicks": 300,
      "release": true
    },
    {
      "kind": "input",
      "label": "push6",
      "press": "KeyG",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "roll6",
      "waitTicks": 300,
      "release": true
    },
    {
      "kind": "input",
      "label": "push7",
      "press": "KeyG",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "roll7",
      "waitTicks": 300,
      "release": true
    },
    {
      "kind": "input",
      "label": "push8",
      "press": "KeyG",
      "holdTicks": 1,
