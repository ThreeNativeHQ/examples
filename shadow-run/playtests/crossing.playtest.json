{
  "name": "shadow-run-crossing",
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "subject": "runner",
  "steps": [
    {
      "kind": "wait",
      "label": "yard-awake",
      "waitTicks": 30,
      "release": true
    },
    {
      "kind": "input",
      "label": "survey",
      "wheel": {
        "deltaY": 200
      },
      "holdTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "label": "into-cover",
      "press": [
        "ArrowUp",
        "ArrowLeft"
      ],
      "holdTicks": 26,
      "release": true
    },
    {
      "kind": "wait",
      "label": "hold-shadow",
      "waitTicks": 40,
      "release": true,
      "screenshot": "shadow-run.png"
    },
    {
      "kind": "input",
      "label": "break-cover",
      "press": "ArrowUp",
      "holdTicks": 50,
      "release": true
    },
    {
      "kind": "input",
      "label": "to-door",
      "press": "ArrowUp",
      "holdTicks": 170,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settled",
      "waitTicks": 20,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "crossed",
        "gte": 17,
        "changed": true
      },
      {
        "id": "state",
        "path": "cameraDistance",
        "changed": true
      },
      {
        "id": "state",
        "path": "bvhRebuilds",
        "changed": true
      },
      {
        "id": "state",
        "path": "inShadow",
        "changed": true
      },
      {
        "id": "state",
        "path": "outcome",
        "atSteps": [
          {
            "label": "yard-awake",
            "equals": "playing"
          },
          {
            "label": "settled",
            "equals": "home"
          }
        ]
      }
    ]
  }
}
