{
  "name": "fox-move",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 20,
  "subject": "player",
  "steps": [
    { "kind": "input", "label": "run right", "press": "ArrowRight", "holdFrames": 120, "release": true },
    { "kind": "input", "label": "jump", "press": "Space", "holdFrames": 12, "release": true },
    { "kind": "wait", "waitFrames": 40, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "movement": { "entity": "player", "minAxisDelta": { "axis": "x", "min": 3 } },
    "resources": [{ "id": "GameState", "path": "coins", "gte": 5, "changed": true }]
  }
}
