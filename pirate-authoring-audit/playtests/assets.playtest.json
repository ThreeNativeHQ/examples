{
  "name": "starter-assets",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    { "kind": "wait", "label": "menu-is-up", "waitTicks": 20, "release": true },
    { "kind": "click", "at": { "x": 640, "y": 365 }, "label": "focus-name-field" },
    { "kind": "input", "label": "type-name", "press": "a", "holdTicks": 1, "release": true },
    { "kind": "click", "at": { "x": 640, "y": 428 }, "label": "start-game" },
    { "kind": "wait", "label": "play-scene-loads", "waitTicks": 600, "release": true },
    {
      "kind": "input",
      "label": "run-toward-the-flag",
      "press": "ArrowRight",
      "holdTicks": 205,
      "release": false
    },
    { "kind": "input", "label": "jump-the-gap", "press": "Space", "holdTicks": 2, "release": true },
    { "kind": "wait", "label": "land-beside-the-pennant", "waitTicks": 120, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "movement": { "entity": "player", "minDistance": 0.5 },
    "resources": [{ "id": "state", "path": "status", "equals": "won", "changed": true }],
    "visibility": [
      {
        "allowTrivial": "The pennant is authored in frame from the first tick so the player can see where to jump; this row proves the compiled model still draws when the run reaches it.",
        "entity": "goal",
        "minProjectedPixels": 20
      }
    ]
  }
}
